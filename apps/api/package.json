{
  "name": "@jobradar/api",
  "version": "1.20.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:migrate:prod": "tsx src/db/neon-apply.ts",
    "telegram:session": "tsx scripts/telegram-session.ts",
    "bot:webhook": "tsx scripts/telegram-webhook.ts",
    "backfill:contacts": "tsx scripts/backfill-apply-contacts.ts",
    "backfill:seniority": "tsx scripts/backfill-seniority.ts",
    "cleanup:junk": "tsx scripts/cleanup-junk-vacancies.ts"
  },
  "dependencies": {
    "@jobradar/shared": "workspace:*",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@sentry/nestjs": "^10.66.0",
    "bullmq": "^5.80.8",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.10.1",
    "ioredis": "^5.11.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "telegram": "^2.26.22",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  }
}
