# Copy to .env and adjust as needed. Values below match docker-compose.yml defaults.

# apps/api
PORT=3001
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://jobradar:jobradar@localhost:5432/jobradar
REDIS_URL=redis://localhost:6379
# Shared secret for POST /ingestion/run (generate with: openssl rand -hex 24)
INGESTION_TOKEN=change-me
# Optional hh.ru application token (dev.hh.ru) — lifts geo-403 for API requests
# HH_API_TOKEN=
# Telegram ingestion (primary source, ADR-009). Get api id/hash at my.telegram.org,
# then generate the session string with: pnpm --filter @jobradar/api telegram:session
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION=

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:3001
