# Copy to .env and adjust as needed. Values below match docker-compose.yml defaults.

# apps/api
PORT=3001
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://jobradar:jobradar@localhost:5432/jobradar
REDIS_URL=redis://localhost:6379
# Shared secret for POST /ingestion/run (generate with: openssl rand -hex 24)
INGESTION_TOKEN=change-me
# Optional hh.ru application token (dev.hh.ru) — lifts geo-403 for API requests
# HH_API_TOKEN=
# Telegram ingestion (primary source, ADR-009). Get api id/hash at my.telegram.org,
# then generate the session string with: pnpm --filter @jobradar/api telegram:session
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION=
# Telegram BOT channel (ADR-015 §6) — a completely separate integration from the
# three vars above: outbound nudges/digest + inline buttons. Create a bot via
# @BotFather for the token, invent the webhook secret yourself
# (openssl rand -hex 24), then register delivery with:
#   API_ORIGIN=https://<public-api-url> pnpm --filter @jobradar/api bot:webhook
# Unset → the channel is off and everything stays in-app.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_WEBHOOK_SECRET=
# API_ORIGIN=http://localhost:3001
# Sentry error reporting (optional; unset → disabled, no cost). DSN from the
# API project in Sentry. SENTRY_TRACES_SAMPLE_RATE opts into tracing (e.g. 0.1).
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
# LLM gateway (ADR-005/ADR-011): free-tier keys, tried in order groq → openrouter
# → gemini. All optional — LLM features politely 503 when none is set.
# *_MODEL overrides are optional too.
# GROQ_API_KEY=
# GROQ_MODEL=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# Email apply via Gmail (ADR-011): OAuth client from a free GCP project with the
# Gmail API enabled ("Web application" type; test-mode consent screen with your
# own account as test user is fine). Redirect URI must match GOOGLE_OAUTH_REDIRECT
# (defaults to http://localhost:3001/gmail/oauth/callback; in prod use the Render
# origin). Unset → the email-apply UI shows "not configured".
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT=

# Day planner tick (ADR-015). Runs in-process, no Redis. Kill switch and pace,
# both changeable from the Render dashboard with no code deploy.
# PLANNER_TICK_DISABLED=1        # stop nudges + auto-close entirely
# PLANNER_TICK_INTERVAL_MS=300000  # relax the tick (default 60000; min 10000)

# Daily vacancy digest. Same in-process interval pattern as the planner tick;
# per-user send times live in the DB, these only gate the runner itself.
# DIGEST_DISABLED=1              # stop sending digests entirely
# DIGEST_INTERVAL_MS=600000      # relax the check (default 300000; min 60000)

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:3001
# Sentry error reporting (optional; unset → disabled). Use the web project's DSN.
# Source-map upload also needs SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN at build.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
